{
	"name": "n8n-nodes-cleanedweb",
	"version": "0.1.0",
	"description": "n8n community node for CleanedWeb: run maintained APIs for public website collections and read their structured records.",
	"license": "MIT",
	"homepage": "https://github.com/cleanedweb/n8n-nodes-cleanedweb#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"cleanedweb",
		"web data",
		"structured data",
		"rest api",
		"data extraction"
	],
	"author": {
		"name": "CleanedWeb",
		"email": "info@cleanedweb.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cleanedweb/n8n-nodes-cleanedweb.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CleanedWebApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CleanedWeb/CleanedWeb.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/cleanedweb/n8n-nodes-cleanedweb/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"publishConfig": {
		"access": "public"
	}
}
